# ---- Discord (https://discord.com/developers/applications → ton app → OAuth2)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Signe les sessions. Génère-en un : openssl rand -base64 32
SESSION_SECRET=

# ---- Sources Stremio
# Addon(s) de streams, séparés par des virgules. Colle l'URL de config Torrentio
# (avec ta clé débrid si tu en as une) : elle ne sort jamais du serveur.
STREAM_ADDON_URLS=https://torrentio.strem.fun/manifest.json
# Addon de catalogue/métadonnées (recherche, fiches, épisodes).
META_ADDON_URL=https://v3-cinemeta.strem.io/manifest.json

# ---- Serveur de streaming Stremio (télécharge les torrents + transcode en HLS)
# Adresse à laquelle CE backend joint le serveur Stremio.
STREMIO_SERVER_URL=http://127.0.0.1:11470
# Adresse à laquelle le serveur Stremio se joint lui-même (laisse par défaut).
STREMIO_SELF_URL=http://127.0.0.1:11470

# ---- Divers
PORT=3001
# 1 = utilisable dans un onglet normal (?room=test&name=Toi) pour tester sans Discord.
ALLOW_BROWSER_MODE=0
# LOG_LEVEL=info
# LOG_REQUESTS=1
# Réglages appliqués au serveur Stremio au démarrage (STREMIO_AUTO_TUNE=0 pour désactiver)
# STREMIO_TRANSCODE_CONCURRENCY=6
# STREMIO_CACHE_GB=100
